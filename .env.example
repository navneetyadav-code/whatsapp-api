# ==============================================================================
# WhatsGateway — Environment Configuration Template
# ==============================================================================

# Application Settings
APP_ENV=production
APP_KEY=generate-a-strong-32-char-encryption-key-for-credentials-at-rest
APP_NAME="WhatsGateway"
APP_PUBLIC_URL=https://your-service-name.onrender.com
APP_BASE_PATH=
APP_SESSION_NAME=whatsgateway_session
APP_SECURE_COOKIES=true
APP_TIMEZONE=UTC
ENABLE_TEST_PAGE=false

# White-Label & Community Branding (Optional)
APP_AUTHOR_NAME="WhatsGateway Community"
APP_SUPPORT_EMAIL=support@example.com
APP_REPO_URL=https://github.com/navneetyadav-code/WhatsGateway

# Security & Private Instance Lockdown
# Set to 'false' on production to prevent strangers from registering accounts!
ENABLE_REGISTRATION=false
DISABLE_PASSWORD_LOGIN=false
ALLOW_NEW_DEVICES=false
ADMIN_EMAIL=admin@example.com

# Authentication & Brute Force Protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ALLOW_QUERY_AUTH=false

# Database Configuration (MySQL 8+ or TiDB Cloud Serverless)
DB_HOST=gateway01.region.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=whatsapp_api
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_SSL=true
DB_SSL_CA=
DB_DSN=
DB_POOL_LIMIT=5

# Background Worker Settings
WORKER_URL=http://127.0.0.1:3107
WORKER_PORT=3107
WORKER_TOKEN=generate-a-strong-secret-token-here
WA_SESSION_DIR=/var/www/html/whatsapp-api-data/sessions

# Anti-Ban, Pacing & Queue Adaptive Engine
DEFAULT_COUNTRY_CODE=91
SEND_DELAY_MS=2500
QUEUE_POLL_MS=3000
QUEUE_POLL_ACTIVE_MS=1000
QUEUE_POLL_IDLE_MS=5000
LOG_LEVEL=warn
WA_MESSAGE_ID_FORMAT=wg_hex

# AI Multi-Key Provider Fallbacks & Models (Optional environment-level fallbacks)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_FALLBACK_MODELS=

# Personal Assistant & Bot Authorization (Optional)
ADMIN_WHITELIST_PHONES=

# Password Reset & OTP Delivery
OTP_VIA_EMAIL=true
OTP_VIA_PHONE=true

# System API Credentials (For Phone OTP / Internal Alerts)
SYSTEM_API_KEY=
SYSTEM_API_SECRET=

# SMTP Configuration (Standard mailer for OTP and alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME="WhatsGateway"

# Alternative Transactional Email Services (Optional)
RESEND_API_KEY=
BREVO_API_KEY=

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Initial Administrator Account Bootstrap (Optional for automated CLI setups)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrator

# TiDB Vector / Knowledge Base Training (Optional)
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_NAME=whatsapp_api
TIDB_SSL_CA=
