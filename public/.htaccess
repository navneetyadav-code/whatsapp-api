RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^public/(.*)$ /$1 [L,R=301]

# Meta WhatsApp Cloud API URL Compatibility (e.g. /v20.0/123456/messages or /api/messages)
RewriteRule ^v[0-9.]+/([0-9]+)/messages/?$ api/send.php [L,QSA]
RewriteRule ^api/messages/?$ api/send.php [L,QSA]
RewriteRule ^messages/?$ api/send.php [L,QSA]

# Clean URL Routing: Route all requests that are not existing files/directories to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]
