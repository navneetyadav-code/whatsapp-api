# Prohibit script execution in the uploads directory
<FilesMatch "(?i)\.(php|phtml|phar|pl|py|cgi|sh|asp|aspx|exe|bat|cmd)$">
    Require all denied
</FilesMatch>

# Disable PHP engine if mod_php is loaded
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
